{
  "name": "trenched",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chrome MV3 extension for Axiom: bond and migration alerts, dev wallet tracking, one-click token research.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xJonty/trenched.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "zip": "npm run build && node scripts/zip.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && tsc --noEmit"
  },
  "dependencies": {
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.7.1",
    "@eslint/js": "10.0.1",
    "@preact/preset-vite": "2.10.6",
    "@types/chrome": "0.2.6",
    "@types/node": "24.13.3",
    "eslint": "10.8.1",
    "jszip": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
